# mint-only-demo: one mutation that mints a locked Web Forms instance.
PORT=4100

# mock  -> no credentials; the URL points at the full-service demo's mock page
# docusign -> the JWT-grant credentials below (see docs/integration/docusign-proxy.md)
ESIGN_PROVIDER=mock
MOCK_PAGES_ORIGIN=http://localhost:4000

# DocuSign (ESIGN_PROVIDER=docusign)
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_WEBFORM_ID=
# DOCUSIGN_RETURN_URL=http://localhost:4000/signing/return
