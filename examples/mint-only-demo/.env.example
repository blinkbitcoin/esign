# mint-only-demo: one mutation (+ the REST spelling, POST /webform/instance)
# that mints a locked Web Forms instance.
PORT=4104

# mock  -> no credentials; the URL points at the full-service demo's mock page
# docusign -> the JWT-grant credentials below (see docs/integration/docusign-proxy.md)
ESIGN_PROVIDER=mock
MOCK_PAGES_ORIGIN=http://localhost:4100

# Production boot guard (packages/esign-node's assertProductionConfig): set
# ESIGN_ENV=production to refuse booting on the mock provider or on
# DocuSign's demo hosts (below); ESIGN_ALLOW_DEMO=true is the one bypass.
# ESIGN_ENV=production
# ESIGN_ALLOW_DEMO=true

# DocuSign (ESIGN_PROVIDER=docusign)
# (dummy values in the real shape; see packages/esign-service/.env.docusign.example)
# DOCUSIGN_ACCOUNT_ID=7d3e5f21-8a4b-4c6d-9e0f-1a2b3c4d5e6f
# DOCUSIGN_INTEGRATION_KEY=2b8c4d6e-1f3a-4b5c-8d7e-9f0a1b2c3d4e
# DOCUSIGN_USER_ID=5a1c9e3d-7b2f-4e8a-b6c4-d0e2f4a6b8c1
# The RSA private key, in one of three sources (first one set wins):
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...PEM lines verbatim...
# -----END RSA PRIVATE KEY-----"
# DOCUSIGN_PRIVATE_KEY_BASE64=  # the same PEM, base64-encoded (one line)
# DOCUSIGN_PRIVATE_KEY_FILE=/run/secrets/docusign_private_key  # a mounted file (Docker/Kubernetes secret)
# The form (the capability test form v2 in docs/integration/webforms.md)
# DOCUSIGN_WEBFORM_ID=c640d957-a2d0-4e36-9975-5374afb02b54
# Where DocuSign sends the signer after the form's envelope is signed: this
# host's own bridge page (GET /signing/return) - it posts the outcome to the
# app; must be a public https URL in production (DocuSign cannot reach
# localhost)
# DOCUSIGN_RETURN_URL=http://localhost:4104/signing/return

# Production hosts (default: the DocuSign developer/demo environment):
# DOCUSIGN_BASE_URL=https://<account base uri>/restapi
# DOCUSIGN_OAUTH_URL=https://account.docusign.com
# DOCUSIGN_WEBFORMS_BASE_URL=https://apps.docusign.com/api/webforms/v1.1
