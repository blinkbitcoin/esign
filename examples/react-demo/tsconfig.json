{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "@blinkbitcoin/esign-react": ["../../packages/esign-react/src"],
      "@blinkbitcoin/esignature-core": [
        "../../packages/esignature-core/src/index.ts"
      ],
      "@blinkbitcoin/esignature-core/webform": [
        "../../packages/esignature-core/src/webform.ts"
      ]
    }
  },
  "include": ["src", "e2e", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
