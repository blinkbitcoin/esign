# serverless-handler-demo: the package's Fetch handlers behind a route.
PORT=4200

# mock  -> no credentials; the mint URL points at the full-service demo's mock page
# docusign -> the JWT-grant credentials + DOCUSIGN_HMAC_KEY for the webhook
ESIGN_PROVIDER=mock
MOCK_PAGES_ORIGIN=http://localhost:4000

# DocuSign (ESIGN_PROVIDER=docusign)
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_WEBFORM_ID=
# DOCUSIGN_HMAC_KEY=
