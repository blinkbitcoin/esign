# serverless-handler-demo: the package's Fetch handlers behind a route.
PORT=4105

# mock  -> no credentials; the mint URL points at the full-service demo's mock page
# docusign -> the JWT-grant credentials + DOCUSIGN_HMAC_KEY for the webhook
ESIGN_PROVIDER=mock
MOCK_PAGES_ORIGIN=http://localhost:4100

# DocuSign (ESIGN_PROVIDER=docusign)
# (dummy values in the real shape; see examples/full-service-demo/.env.docusign.example)
# DOCUSIGN_ACCOUNT_ID=7d3e5f21-8a4b-4c6d-9e0f-1a2b3c4d5e6f
# DOCUSIGN_INTEGRATION_KEY=2b8c4d6e-1f3a-4b5c-8d7e-9f0a1b2c3d4e
# DOCUSIGN_USER_ID=5a1c9e3d-7b2f-4e8a-b6c4-d0e2f4a6b8c1
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...PEM lines verbatim...
# -----END RSA PRIVATE KEY-----"
# DOCUSIGN_WEBFORM_ID=1228ee55-ce36-4b87-8646-39c93d50ee69
# DOCUSIGN_HMAC_KEY=
