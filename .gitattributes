# Line-ending normalization: LF in the repo, auto-converted on checkout
* text=auto

# Xcode project files: never normalize (Xcode manages encoding/EOL itself)
*.pbxproj -text

# Windows scripts require CRLF (gradlew.bat)
*.bat text eol=crlf

# Binary artifacts
*.jar binary

# Generated files: collapse in GitHub PR diffs
package-lock.json linguist-generated=true
flake.lock linguist-generated=true
