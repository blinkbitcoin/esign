# direnv configuration (house convention - see sibling blink repos)
# Loads env from .env files and enters the nix flake dev shell on cd;
# run `direnv allow` once per machine.
# Supported variables: see .env.example (root) and packages/esign-service/.env.example
# (backend) - the templates are the registry, this file only loads them.

dotenv_if_exists .env
dotenv_if_exists .env.local

use flake

# Workspace bins (tsx, knex, biome, jest, vitest, eslint, ...) on PATH
PATH_add node_modules/.bin

# Each linked worktree owns a port block (scripts/lib/ports.mjs): claimed once
# into .env.local, which the dotenv line above loads on every later cd. The
# main clone and CI keep the default block; an explicit ESIGN_PORT_BASE in
# .env / .env.local / the shell wins. `make ports` shows the block.
if [ -z "${ESIGN_PORT_BASE:-}" ]; then
  export ESIGN_PORT_BASE="$(node scripts/e2e/ports.mjs claim)"
fi
