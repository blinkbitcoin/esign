flowchart TB
    subgraph Apps["App packages"]
        RN[React Native app<br/>esign-react-native: WebView]
        WEB[React web app<br/>esign-react: iframe / DocuSign.js]
        CORE["esign-core<br/>signing machine + SigningSource<br/>proxy / hosted form / web forms / public URL"]
        RN --> CORE
        WEB --> CORE
    end

    subgraph TierA["Tier A - in-process: your API imports esign-node"]
        API["Your Node API<br/>createHostedFormRouter (Express)<br/>createHostedFormApp (Fetch)<br/>or one GraphQL mutation"]
        HOOKA["your authenticate() + prefill() hooks<br/>session and terms never leave your process"]
        API --> HOOKA
    end

    subgraph TierB["Tier B - deployed: esign-service (Fetch core on esign-node)"]
        ENTRY{"entries<br/>./node = the image · ./vercel<br/>./cloudflare = mint only"}
        APP["createESignApp(env)<br/>boot guard · CORS · security headers"]
        subgraph Mint["mint - always on"]
            WFI[/"POST /webform/instance"/]
            SP[/"GET /signing/return + mock pages"/]
            HEALTH[/"GET /health -> capabilities"/]
        end
        subgraph Envelopes["envelopes - only with DATABASE_URL"]
            GQL[/"/graphql (Apollo)"/]
            WH[/"POST /webhook/esign"/]
            KNEX[Knex EnvelopeStore]
        end
        PROV{"ESignProvider<br/>providerFromEnv(ESIGN_PROVIDER)"}
        ENTRY --> APP
        APP --> WFI & SP & HEALTH
        APP -->|DATABASE_URL set| Envelopes
        GQL --> KNEX
        WH --> KNEX
    end

    subgraph Host["The host's two obligations (Tier B)"]
        IDP[["SESSION_JWKS_URL<br/>or SESSION_HS256_SECRET<br/>-> the user id"]]
        TERMS[["TERMS_URL<br/>-> the locked prefill"]]
    end

    subgraph External["External"]
        DOCU[DocuSign API<br/>eSignature + Web Forms]
        DB[(PostgreSQL)]
    end

    CORE -->|"mint (REST)"| API
    CORE -->|"mint (REST)"| WFI
    CORE -->|GraphQL - proxy mode| GQL
    RN -.->|embedded signing + bridge| SP
    WEB -.->|embedded signing + bridge| SP

    API -->|esign-node| DOCU
    WFI -->|verify the bearer token| IDP
    WFI -->|POST userId + input| TERMS
    WFI --> PROV
    GQL --> PROV
    PROV -->|REST| DOCU
    DOCU -->|Connect webhook| WH
    KNEX --> DB
