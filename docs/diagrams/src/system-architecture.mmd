flowchart TB
    subgraph Hosts["Host apps"]
        RN[React Native app<br/>esign-react-native: WebView]
        WEB[React web app<br/>esign-react: iframe / DocuSign.js]
    end

    subgraph Core["esign-core (shared)"]
        MACHINE[signing machine<br/>transition / effects]
        SRC{SigningSource}
        PROXY[createProxySigningSource<br/>Apollo - proxy mode only]
        HF[createHostedFormSource<br/>neutral hosted forms]
        subgraph CoreDS["providers/docusign (./docusign entry)"]
            WF[createWebFormsSource]
            PUB[createPublicUrlSource]
        end
    end

    subgraph Backend["Backend on esign-server: full-service-demo (all modes) - or your own API with one mutation (mint-only) / route handlers (serverless)"]
        GQL[/"GraphQL /graphql"/]
        WFI[/"POST /webform/instance"/]
        WH[/"POST /webhook/esign"/]
        SP[/"signing pages + return-URL bridge"/]
        PROV{ESignProvider}
        DS["DocuSignProvider<br/>(src/docusign/, ./docusign entry)"]
        MOCK[MockProvider]
        REG{providerFromEnv<br/>ESIGN_PROVIDER}
        KNEX[Knex.js]
    end

    subgraph External["External"]
        DOCU[DocuSign API<br/>eSignature + Web Forms]
        DB[(PostgreSQL)]
    end

    RN --> MACHINE
    WEB --> MACHINE
    RN --> SRC
    WEB --> SRC
    SRC --> PROXY & HF
    HF --> WF & PUB
    PROXY -->|GraphQL| GQL
    WF -->|one mint call| WFI
    GQL --> PROV
    WFI --> PROV
    PROV --> REG
    REG --> DS & MOCK
    DS -->|REST| DOCU
    DOCU -->|webhooks| WH
    GQL --> KNEX
    WH --> KNEX
    KNEX --> DB
    RN -.->|embedded signing + bridge| SP
    WEB -.->|embedded signing + bridge| SP
