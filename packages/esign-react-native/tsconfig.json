{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
    "paths": {
      "@blinkbitcoin/esignature-core": ["../esignature-core/src/index.ts"],
      "@blinkbitcoin/esignature-core/webform": [
        "../esignature-core/src/webform.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "__mocks__/**/*.ts",
    "__mocks__/**/*.tsx"
  ],
  "exclude": ["node_modules", "lib"]
}
