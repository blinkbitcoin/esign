{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
    "paths": {
      "@blinkbitcoin/esign-core": ["../esign-core/src/index.ts"],
      "@blinkbitcoin/esign-core/webform": ["../esign-core/src/webform.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
