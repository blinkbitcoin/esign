{
  "name": "@blinkbitcoin/esign-react-native",
  "version": "0.1.0",
  "description": "Plug-and-play e-signature signing flow component for React Native, backed by the e-sign GraphQL service",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./webform": {
      "react-native": "./src/webform.ts",
      "import": {
        "types": "./lib/typescript/module/src/webform.d.ts",
        "default": "./lib/module/webform.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/webform.d.ts",
        "default": "./lib/commonjs/webform.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "!**/__tests__", "!**/__mocks__"],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bob build",
    "clean": "rm -rf lib"
  },
  "keywords": ["react-native", "e-signature", "docusign", "signing"],
  "license": "MIT",
  "peerDependencies": {
    "@apollo/client": "^4.0.0",
    "@react-native-community/netinfo": ">=11.0.0",
    "graphql": "^16.8.0 || ^17.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "react-native-webview": ">=14.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.2.5",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.5",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "graphql": "^16.14.2",
    "jest": "^29.7.0",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.0",
    "react-native-webview": "^14.0.1",
    "react-test-renderer": "19.2.7",
    "typescript": "^7.0.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@blinkbitcoin/esign-core": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkbitcoin/blink-esign.git",
    "directory": "packages/esign-react-native"
  },
  "sideEffects": false,
  "type": "commonjs",
  "engines": {
    "node": ">= 18"
  }
}
