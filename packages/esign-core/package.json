{
  "name": "@blinkbitcoin/esign-core",
  "version": "0.1.0",
  "description": "Platform-agnostic core (SigningSource abstraction, Apollo client factory, GraphQL operations) shared by the e-signature React and React Native packages",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./webform": {
      "react-native": "./src/webform.ts",
      "import": {
        "types": "./dist/webform.d.mts",
        "default": "./dist/webform.mjs"
      },
      "require": {
        "types": "./dist/webform.d.ts",
        "default": "./dist/webform.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["src", "dist", "!**/__tests__"],
  "sideEffects": false,
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup",
    "clean": "rm -rf dist",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "keywords": ["e-signature", "docusign", "signing"],
  "license": "MIT",
  "peerDependencies": {
    "@apollo/client": "^4.0.0",
    "graphql": "^16.8.0 || ^17.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.2.5",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^8.0.1",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.5",
    "@types/jest": "^29.5.14",
    "graphql": "^16.14.2",
    "jest": "^29.7.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkbitcoin/blink-esign.git",
    "directory": "packages/esign-core"
  },
  "type": "commonjs",
  "engines": {
    "node": ">= 18"
  }
}
