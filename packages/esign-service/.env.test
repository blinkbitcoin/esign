# The E2E Postgres on its default port (ESIGN_TEST_DB_PORT = ESIGN_PORT_BASE + 12);
# scripts/e2e/test-db.sh run exports the worktree's own URL over this one
DATABASE_URL=postgresql://test:test@localhost:4112/esign_test
ESIGN_PROVIDER=mock
# No session or webhook secrets: the bearer token is the user id and an
# unsigned webhook is accepted, which the boot banner reports. Nothing opts
# into that - it is what an unconfigured deployment does.
# The demo's GraphQL explorer needs schema discovery, which is off by default
ESIGN_GRAPHQL_INTROSPECTION=true
# The web demo origins on the default block; backend-up.sh and the Playwright
# configs export the worktree's own
ESIGN_CORS_ALLOWED_ORIGINS=http://localhost:4101,http://localhost:4102,http://localhost:4103
