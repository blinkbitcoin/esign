# Every variable the esign service reads.
#
# This file is GENERATED from packages/esign-service/src/env/registry.ts -
# run `make env-docs` after changing it. The registry is also where the doc
# tables and the boot banner's hints come from, so a variable is described
# once and appears everywhere.
#
# The service starts with almost none of this set: it reports what it does
# and does not verify (the boot banner) and runs. ESIGN_STRICT=true turns
# every reported gap into a refusal to start.

# ---------------------------------------------------------------------------
# Local development. These two carry concrete values because they are the
# local port contract (scripts/lib/ports.mjs pins them): every service in the
# repo derives its port from ESIGN_PORT_BASE, default 4100, and a linked
# worktree claims its own block. `make ports` shows this worktree's.
# ---------------------------------------------------------------------------
PORT=4100
# The dev Postgres of `make db-up` (ESIGN_DEV_DB_PORT = ESIGN_PORT_BASE + 13)
DATABASE_URL=postgresql://dev:dev@localhost:4113/esign

# ---------------------------------------------------------------------------
# Every variable, generated from the registry. The two above appear here too,
# with what they mean and how to choose them.
# ---------------------------------------------------------------------------
# BEGIN GENERATED - edit packages/esign-service/src/env/registry.ts
# Decides whether this deployment orchestrates envelopes at all. Unset, the
# mint is the whole service and no Postgres connection is opened.
# How to obtain:
# Your Postgres connection string. Apply the schema once with:
#   node dist/node.js migrate
# Default: unset - the mint alone, on every target
# DATABASE_URL=

# Which of the two mints this deployment answers with. They are different
# products: a Web Form asks the signer questions first, an envelope puts
# them straight into the documents.
# Default: 'webform'
# ESIGN_MINT_MODE=

# Which e-signature provider mints. The mock needs no credentials and signs
# nothing that holds.
# Default: 'mock' - which the boot banner reports as a demo provider
# ESIGN_PROVIDER=

# Verifies that a caller's bearer token really came from your login
# provider. Without a session source the service cannot tell one user from
# another: it takes the token as the user id.
# How to obtain:
# Your identity provider publishes it. Take jwks_uri from its discovery
# document:
#   curl -s https://<issuer>/.well-known/openid-configuration | jq -r .jwks_uri
# Auth0, Okta, Cognito, Keycloak and Firebase all have one. If your own
# backend
# issues the tokens, use ESIGN_SESSION_SECRET instead - it is an equal, not
# a
# fallback. Confirm it with:
#   node dist/node.js check-session "$TOKEN"
# Default: unset - see ESIGN_SESSION_SECRET, then the note above
# ESIGN_SESSION_JWKS_URL=

# The same verification, for a backend that issues its own tokens and signs
# them with a shared secret.
# How to obtain:
# The secret your own backend signs session tokens with - the same value,
# not a new one.
# Prefer ESIGN_SESSION_JWKS_URL when you have an identity provider: this
# service then
# holds no signing material and cannot mint tokens even if it is
# compromised.
# Default: unset
# ESIGN_SESSION_SECRET=

# Pins which issuer a token may come from. Without it any token your key
# material verifies is accepted, whoever issued it.
# How to obtain:
# The iss claim of a real token, copied exactly:
#   echo "$TOKEN" | cut -d. -f2 | base64 -d | jq -r .iss
# Trailing slashes count. check-session names both sides when they differ.
# Default: unset - the issuer is not checked
# ESIGN_SESSION_ISSUER=

# Pins which audience a token was minted for, so a token issued for another
# service of yours is not accepted here.
# How to obtain:
# The aud claim of a real token:
#   echo "$TOKEN" | cut -d. -f2 | base64 -d | jq -r .aud
# Default: unset - the audience is not checked
# ESIGN_SESSION_AUDIENCE=

# Which claim carries your user id. DocuSign sees this value as
# clientUserId, so it is what ties a signature to a person.
# How to obtain:
# Look at a real token and pick the claim holding your user id:
#   echo "$TOKEN" | cut -d. -f2 | base64 -d | jq
# Default: 'sub'
# ESIGN_SESSION_USER_CLAIM=

# Decides who computes the values a signer cannot change. Unset, the
# client's own prefill is minted as sent - which is fine for a fixed consent
# form and wrong for anything whose fields carry the deal.
# How to obtain:
# An endpoint on your own backend that you write. It receives
#   { userId, input }        (an envelope mint also sends recipient)
# and answers
#   { prefill: { ... } }     (and, for an envelope, an optional recipient)
# Confirm it answers correctly with:
#   node dist/node.js check-prefill
# Default: unset - the client's prefill is minted as sent
# ESIGN_PREFILL_URL=

# Lets your prefill endpoint tell this service apart from anything else that
# finds the URL.
# How to obtain:
# Any high-entropy string you also configure on the receiving endpoint:
#   openssl rand -hex 32
# Default: unset - the header is not sent
# ESIGN_PREFILL_SECRET=

# Bounds how long a mint waits on your backend before answering 502.
# Default: 5000
# ESIGN_PREFILL_TIMEOUT_MS=

# Turns every line the boot banner reports as unverified into a refusal to
# start. Off by default because what an unverified session or a
# client-supplied prefill means depends on your architecture, which this
# process cannot see.
# Default: unset - the service reports its posture and starts
# ESIGN_STRICT=

# Apollo's schema discovery. Off by default so a deployment does not publish
# its schema without saying so.
# Default: unset - introspection is off
# ESIGN_GRAPHQL_INTROSPECTION=

# Identifies your application to DocuSign. Without the JWT-grant credentials
# nothing can be minted.
# How to obtain:
# DocuSign Admin -> Apps and Keys. The full click path, including the
# consent step that is easy to miss, is docs/integration/docusign-proxy.md.
# The integration key is the GUID shown on the app.
# Required: ESIGN_PROVIDER=docusign
# DOCUSIGN_INTEGRATION_KEY=

# Which DocuSign account the envelopes and instances belong to.
# How to obtain:
# DocuSign Admin -> Account -> API and Keys: the "API Account ID" GUID, not
# the account number.
# Required: ESIGN_PROVIDER=docusign
# DOCUSIGN_ACCOUNT_ID=

# Whom the service impersonates. Envelopes are sent as this user.
# How to obtain:
# DocuSign Admin -> Users -> the service user -> "API Username" (a GUID).
# That user must have granted consent once.
# Required: ESIGN_PROVIDER=docusign
# DOCUSIGN_USER_ID=

# Proves the service is the integration key it claims to be. The only
# DocuSign value that is a secret.
# How to obtain:
# Generate a keypair, upload the public half on the integration key:
#   openssl genrsa -out esign.pem 2048 && openssl rsa -in esign.pem -pubout
# Paste the private PEM verbatim. DocuSign Admin -> Apps and Keys. The full
# click path, including the consent step that is easy to miss, is
# docs/integration/docusign-proxy.md.
# Alternatives: DOCUSIGN_PRIVATE_KEY_BASE64 (every target),
# DOCUSIGN_PRIVATE_KEY_FILE (a container secret mount).
# Required: ESIGN_PROVIDER=docusign
# DOCUSIGN_PRIVATE_KEY=

# The same key where a multi-line environment value is awkward.
# How to obtain:
#   base64 -i esign.pem
# Required: instead of DOCUSIGN_PRIVATE_KEY
# DOCUSIGN_PRIVATE_KEY_BASE64=

# The same key from a mounted secret, so it never appears in the
# environment.
# How to obtain:
# The path a secret is mounted at, e.g. /run/secrets/docusign.pem.
# Container-only: a Worker has no filesystem.
# Required: instead of DOCUSIGN_PRIVATE_KEY
# DOCUSIGN_PRIVATE_KEY_FILE=

# Which Web Form the mint creates an instance of.
# How to obtain:
# DocuSign -> Web Forms -> the form -> its id in the URL. The form must be
# active.
# Required: the Web Form mint (ESIGN_MINT_MODE=webform)
# DOCUSIGN_WEBFORM_ID=

# Which template(s) an envelope is created from.
# How to obtain:
# DocuSign -> Templates -> the template -> its id. `make docusign-template`
# creates the fixture one and prints its id.
# Required: ESIGN_MINT_MODE=envelope, or envelope orchestration
# DOCUSIGN_TEMPLATE_ID=

# Where DocuSign sends the signer afterwards. It must reach this service's
# bridge, which is what reports completion back to your app.
# How to obtain:
# This deployment's public URL plus /signing/return. It has to be reachable
# by the signer's browser, not just by the service.
# Required: ESIGN_PROVIDER=docusign
# DOCUSIGN_RETURN_URL=

# Which template role the signer fills.
# How to obtain:
# The role name on the template, as spelled there.
# Default: 'signer'
# DOCUSIGN_SIGNER_ROLE=

# Proves an inbound webhook really came from DocuSign. Without it anyone who
# finds the URL can write 'completed' into your envelope records.
# How to obtain:
# DocuSign Admin -> Connect -> your configuration -> Add HMAC key. DocuSign
# shows the secret once.
# Default: unset - the banner reports an unverified webhook
# DOCUSIGN_HMAC_KEY=

# Which DocuSign environment this is. The default is the demo one, which
# signs nothing that holds up.
# How to obtain:
# DocuSign Admin -> API and Keys shows your account's base URI, e.g.
#   https://na4.docusign.net/restapi
# The region prefix differs per account.
# Default: the demo host - reported as a sandbox by the boot banner
# DOCUSIGN_BASE_URL=

# Where the JWT grant is exchanged. It has to match the environment of the
# account.
# How to obtain:
# https://account.docusign.com for production; the default is the demo host.
# Default: the demo host
# DOCUSIGN_OAUTH_URL=

# Where Web Forms instances are minted. Same environment rule again.
# How to obtain:
# https://apps.docusign.com/api/webforms/v1.1 for production; the default is
# the demo host.
# Default: the demo host
# DOCUSIGN_WEBFORMS_BASE_URL=

# Which port the Node target listens on. A function target is told by its
# platform.
# Default: ESIGN_PORT_BASE (4100)
# PORT=

# The base every service in this repo derives its port from, so parallel
# worktrees do not collide.
# Default: 4100
# ESIGN_PORT_BASE=

# Whether x-forwarded-for may be believed. It is a caller-controlled header,
# so believing it without a proxy in front lets anyone spoof their address
# past the rate limits.
# How to obtain:
# Set it to true only when something you control terminates connections in
# front of this service.
# Default: unset - x-forwarded-for is ignored
# ESIGN_TRUST_PROXY=

# Which browser origins may call the mint and the GraphQL API.
# How to obtain:
# The origins of your own web app, e.g. https://app.example.com.
# Default: unset - same-origin only
# ESIGN_CORS_ALLOWED_ORIGINS=

# Caps mints per client per minute. Each one costs a real DocuSign instance.
# Default: 60
# ESIGN_RATE_LIMIT_WEBFORM_PER_MIN=

# The same cap for the envelope mint.
# Default: 60
# ESIGN_RATE_LIMIT_ENVELOPE_PER_MIN=

# Caps inbound webhooks, which arrive unauthenticated until the signature is
# checked.
# Default: 120
# ESIGN_RATE_LIMIT_WEBHOOK_PER_MIN=

# Caps GraphQL requests per client.
# Default: 100
# ESIGN_RATE_LIMIT_GRAPHQL_PER_MIN=

# Whether the mock provider serves its own signing pages. A deployment that
# only wants the mint surface turns them off.
# Default: on for the mock provider
# ESIGN_MOCK_PAGES=

# Where the mock's signing URLs point, when it is not this service's own
# origin.
# Default: this service's own origin
# ESIGN_MOCK_PAGES_ORIGIN=

# Turns tracing on. Off unless set, so no deployment ships spans it did not
# ask for.
# How to obtain:
# Your collector's OTLP endpoint, e.g. http://localhost:4318. Any OTLP
# backend works.
# Default: unset - tracing off
# OTEL_EXPORTER_OTLP_ENDPOINT=

# What this service is called in traces.
# Default: 'esign-service'
# OTEL_SERVICE_NAME=

# Prints spans to stdout instead of shipping them, for debugging without a
# collector.
# Default: unset
# OTEL_TRACES_EXPORTER=

# Node's own switch (dependency resolution, framework defaults). It decides
# nothing about this service's posture - ESIGN_STRICT does.
# Default: 'production' in the image
# NODE_ENV=
# END GENERATED
