# Every variable the esign service reads. The contract is identical on every
# target - container, Kubernetes, Vercel, Cloudflare - except the four marked
# CONTAINER ONLY. The service refuses to start (listing every problem at once,
# with the capabilities that are on) when this file is incomplete.

# --- Capabilities --------------------------------------------------------
# The mint (POST /webform/instance, or POST /envelope/instance under
# ESIGN_MINT_MODE=envelope; GET /signing/return, GET /health) is always on.
# DATABASE_URL adds envelope orchestration: the GraphQL API,
# POST /webhook/esign and the Postgres store. Leave it unset for a mint-only
# deployment - no connection is opened and no webhook secret is needed.
# Apply the schema once per database: `node dist/node.js migrate`.
# The dev Postgres of make db-up: ESIGN_DEV_DB_PORT = ESIGN_PORT_BASE + 13 (default
# 4113; make ports shows this worktree's). Unset, the Makefile targets default to it
DATABASE_URL=postgresql://dev:dev@localhost:4113/esign

# --- Session verification (pick one) -------------------------------------
# The caller's bearer token becomes the user id the instance is locked to
# (DocuSign's clientUserId). Either a remote key set (RS/ES) ...
# ESIGN_SESSION_JWKS_URL=https://id.example.com/.well-known/jwks.json
# ESIGN_SESSION_ISSUER=https://id.example.com
# ESIGN_SESSION_AUDIENCE=esign
# ESIGN_SESSION_USER_CLAIM=sub                # default: sub
# ... or a shared HS256 secret:
# ESIGN_SESSION_SECRET=change-me
# With neither the token is taken at face value and the boot banner says so.
# That is a real deployment when a gateway already authenticated the caller;
# ESIGN_STRICT=true below refuses to start instead.

# --- Locked terms --------------------------------------------------------
# The endpoint that computes what is actually minted. The service POSTs
# { userId, input: <client prefill> } with the caller's bearer token
# forwarded, and the reply's { prefill } wins over the client's values key by
# key - so a client value can never become a locked one. A non-2xx or a
# timeout answers 502 "Could not compute the signing terms".
# An envelope mint (ESIGN_MINT_MODE=envelope) POSTs
# { userId, input: <client prefill, or {}>, recipient: <client signer> } and
# the reply { prefill, recipient } is the whole of what is minted: the lock
# travels with each value on an envelope, so nothing the client sent reaches
# the document unless the host answers it. The prefill must fit the envelope
# contract (Text tab labels to a string or { value, locked }; empty leaves the
# template its own values) and the recipient ({ name, email } strings) is who
# signs. A reply without either is the same 502.
# ESIGN_PREFILL_URL=https://api.example.com/internal/esign/terms
# ESIGN_PREFILL_SECRET=change-me         # sent as x-esign-prefill-secret
# ESIGN_PREFILL_TIMEOUT_MS=5000
# The callback carries the caller's session token and the shared secret, so
# under ESIGN_ENV=production ESIGN_PREFILL_URL must be https - unless its host is
# private (loopback, *.svc, *.svc.cluster.local, *.internal) or you say so:
# TERMS_ALLOW_INSECURE=true
# Without ESIGN_PREFILL_URL the client's prefill (and an envelope's signer) is minted
# as sent. Production refuses that unless you say so explicitly:
# ESIGN_ALLOW_CLIENT_PREFILL=true

# --- Provider ------------------------------------------------------------
# 'mock' (default) for development and testing without DocuSign credentials,
# 'docusign' for the real integration.
ESIGN_PROVIDER=mock
# Serve the mock provider's signing pages (mock provider only; default on)
# ESIGN_MOCK_PAGES=false

# What the mint answers with (neither needs a database):
#   webform   (default) POST /webform/instance mints a Web Forms instance; the
#             signer answers the form's pages before reaching the document
#   envelope  POST /envelope/instance takes { recipient, prefill }, creates ONE
#             envelope from DOCUSIGN_TEMPLATE_ID (several ids, in that order)
#             and answers its signing URL: the signer opens the documents
#             themselves. ESIGN_PREFILL_URL applies here too (Locked terms, above).
#             With DATABASE_URL the envelope is also stored and audited, as
#             the GraphQL API's are, and envelopeId is the stored id.
# Any other value refuses to start.
# ESIGN_MINT_MODE=envelope

# DocuSign configuration (required when ESIGN_PROVIDER=docusign; JWT grant).
# The complete live layout with realistic dummy values is .env.docusign.example;
# `make docusign-env` (repo root) writes it for you. Setup + consent:
# docs/integration/docusign-proxy.md
# DOCUSIGN_INTEGRATION_KEY=2b8c4d6e-1f3a-4b5c-8d7e-9f0a1b2c3d4e
# DOCUSIGN_ACCOUNT_ID=7d3e5f21-8a4b-4c6d-9e0f-1a2b3c4d5e6f
# DOCUSIGN_USER_ID=5a1c9e3d-7b2f-4e8a-b6c4-d0e2f4a6b8c1
# DOCUSIGN_WEBFORM_ID=1228ee55-ce36-4b87-8646-39c93d50ee69   # the Web Form mint needs this
# DOCUSIGN_RETURN_URL=http://localhost:4100/signing/return   # the mint needs this
# DOCUSIGN_TEMPLATE_ID=c4d6e8f0-2a1b-4c3d-9e8f-7a6b5c4d3e2f  # envelopes and the envelope mint; several ids comma-separated = one envelope
# DOCUSIGN_SIGNER_ROLE=signer                                # envelopes and the envelope mint; the template's role name (default signer)
# DOCUSIGN_HMAC_KEY=c2e9a4d7f1b8e6c3a5d9f2b7e4c1a8d6         # envelopes only
# The private key, in one of three ways:
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...PEM lines verbatim (double-quoted multiline works with dotenv)...
# -----END RSA PRIVATE KEY-----"
# DOCUSIGN_PRIVATE_KEY_BASE64=...       # works on every target
# DOCUSIGN_PRIVATE_KEY_FILE=/run/secrets/docusign.pem   # CONTAINER ONLY
# Hosts default to the DocuSign developer (demo) environment. Production:
# DOCUSIGN_BASE_URL=https://na4.docusign.net/restapi
# DOCUSIGN_OAUTH_URL=https://account.docusign.com
# DOCUSIGN_WEBFORMS_BASE_URL=https://apps.docusign.com/api/webforms/v1.1

# --- Deployment ----------------------------------------------------------
# The service reports what it verifies at boot - provider, session, prefill,
# webhook - and starts either way, because whether an unverified session or a
# client-supplied prefill matters depends on your architecture, not on this
# process. ESIGN_STRICT=true turns every unverified line into a refusal,
# naming the variable that fixes it.
# ESIGN_STRICT=true

# Apollo's schema discovery. Off unless asked for.
# ESIGN_GRAPHQL_INTROSPECTION=true

# Browser origins allowed to call the mint and the GraphQL API. Empty means
# same-origin only.
# ESIGN_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Container only ------------------------------------------------------
# A function relies on its platform for the port, the proxy and the limits.
PORT=4100
# ESIGN_TRUST_PROXY=true                      # take the client from x-forwarded-for
# ESIGN_RATE_LIMIT_WEBFORM_PER_MIN=60         # 0 switches a route's limit off
# ESIGN_RATE_LIMIT_ENVELOPE_PER_MIN=60
# ESIGN_RATE_LIMIT_WEBHOOK_PER_MIN=120
# ESIGN_RATE_LIMIT_GRAPHQL_PER_MIN=100

# --- Observability (OpenTelemetry, all optional - off unless set) ---------
# Standard OTEL_* vars; works with any OTLP backend (collector, Tempo, Honeycomb, Jaeger).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=esign-service
# Local debugging without a collector: print spans to stdout
# OTEL_TRACES_EXPORTER=console
