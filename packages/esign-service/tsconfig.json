{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "resolveJsonModule": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@blinkbitcoin/esign-node": ["../../packages/esign-node/src/index.ts"],
      "@blinkbitcoin/esign-node/express": ["../../packages/esign-node/src/express.ts"],
      "@blinkbitcoin/esign-node/knex": ["../../packages/esign-node/src/knex.ts"],
      "@blinkbitcoin/esign-node/docusign": ["../../packages/esign-node/src/docusign.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
