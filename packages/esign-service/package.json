{
  "name": "@blinkbitcoin/esign-service",
  "version": "0.0.0-development",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/node.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.test -- vitest run --config vitest.e2e.config.mts",
    "test:live": "dotenv -e .env -- vitest run --config vitest.live.config.mts",
    "migrate": "tsx src/migrate.ts",
    "migrate:test": "dotenv -e .env.test -- npm run migrate",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "schema:emit": "tsx scripts/emit-schema.ts",
    "docusign:check": "tsx scripts/docusign-check.ts",
    "test:live:env": "vitest run --config vitest.live.config.mts",
    "docusign:template": "tsx scripts/docusign-template.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "The esign service as one deployable: a Fetch-native core that mints locked hosted-form instances always, adds envelope orchestration when DATABASE_URL is set, and runs as a container, a Node process, a Vercel route or a Cloudflare Worker from the same environment contract.",
  "files": ["dist", "deploy", "!deploy/**/.wrangler", "!deploy/**/node_modules"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkbitcoin/esign.git",
    "directory": "packages/esign-service"
  },
  "homepage": "https://github.com/blinkbitcoin/esign#readme",
  "bugs": {
    "url": "https://github.com/blinkbitcoin/esign/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": "^22.22.2 || >= 24.15.0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@blinkbitcoin/esign-node": "0.0.0-development",
    "@hono/node-server": "^2.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-graphql": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "knex-mock-client": "^3.0.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "esign-service": "./dist/node.js"
  }
}
