{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["jest", "node"],
    "paths": {
      "@blinkbitcoin/esign-core": ["../esign-core/src/index.ts"],
      "@blinkbitcoin/esign-core/docusign": ["../esign-core/src/docusign.ts"],
      "@blinkbitcoin/esign-core/webform": ["../esign-core/src/webform.ts"],
      "@blinkbitcoin/esign-react/docusign": ["./src/docusign.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
