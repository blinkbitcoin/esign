# Root-level env (loaded by direnv via .envrc; copy to .env, gitignored).
# Backend variables live in packages/esign-service/.env.example - this file only carries
# the demo apps' bundle-time mode switches and the port block.

# The port block: every service listens on ESIGN_PORT_BASE + its offset
# (scripts/lib/ports.mjs; `make ports` lists them). A linked worktree claims
# its own block automatically into .env.local (gitignored) - set the variable
# here or in the shell only to pick a block by hand.
# ESIGN_PORT_BASE=4300

# Signing mode for the React Native demo (inlined when Metro bundles):
# proxy (default) | webform | publicurl
# ESIGN_MODE=webform

# Same for the web demo (Vite):
# VITE_ESIGN_MODE=webform
