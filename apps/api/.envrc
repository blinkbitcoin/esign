# direnv configuration (house convention)
# Inherits the repo root .envrc (workspace bin PATH), then loads the backend
# env. The app also self-loads .env via dotenv/config as a fallback for
# non-direnv environments (CI, IDE launch configs); dotenv never overrides
# variables direnv has already exported, so precedence stays consistent.

source_up_if_exists

dotenv_if_exists .env
dotenv_if_exists .env.local
