{
  "name": "api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.test -- vitest run --config vitest.e2e.config.ts",
    "test:live": "dotenv -e .env -- vitest run --config vitest.live.config.ts",
    "migrate": "tsx \"$(command -v knex)\" migrate:latest",
    "migrate:test": "dotenv -e .env.test -- npm run migrate",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "schema:emit": "tsx scripts/emit-schema.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-express": "^0.67.0",
    "@opentelemetry/instrumentation-graphql": "^0.67.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-pg": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.29.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "graphql": "^16.14.2",
    "helmet": "^8.2.0",
    "knex": "^3.3.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv-cli": "^11.0.0",
    "knex-mock-client": "^3.0.2",
    "supertest": "^7.2.2",
    "tsx": "^4.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
