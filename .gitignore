# direnv (.envrc IS tracked - house convention; local env + cache are not)
.env
.env.local
.direnv/

# BMAD document-project scan-state archives (git history is the real archive)
docs/.archive/

# Claude Code local settings (per-user permissions; commands/ and skills/ stay tracked)
.claude/settings.local.json

# Serena (AI tooling) local project state
.serena/

# TypeScript incremental build info
*.tsbuildinfo

# Library build output (bob: lib/, tsup: dist/) and Vite build output
packages/*/lib/
packages/*/dist/
examples/*/dist/
